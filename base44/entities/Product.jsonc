{
  "name": "Product",
  "type": "object",
  "properties": {
    "slug_pl": {
      "type": "string",
      "description": "Polish URL slug, e.g. kontener-20-stop"
    },
    "slug_de": {
      "type": "string",
      "description": "German URL slug, e.g. 20-fuss-container"
    },
    "name_pl": {
      "type": "string"
    },
    "name_de": {
      "type": "string"
    },
    "short_description_pl": {
      "type": "string"
    },
    "short_description_de": {
      "type": "string"
    },
    "description_pl": {
      "type": "string"
    },
    "description_de": {
      "type": "string"
    },
    "size": {
      "type": "string",
      "enum": [
        "10ft",
        "20ft",
        "40ft"
      ]
    },
    "container_type": {
      "type": "string",
      "enum": [
        "standard",
        "high_cube",
        "open_side"
      ]
    },
    "is_variable": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "draft"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "DEMO/DRAFT sample record - never submit to Merchant"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featured_image": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specs": {
      "type": "array",
      "description": "Technical specifications shown on product page",
      "items": {
        "type": "object",
        "properties": {
          "label_pl": {
            "type": "string"
          },
          "label_de": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "variant_attributes": {
      "type": "array",
      "description": "Attribute keys used to build variants, e.g. ['condition','color']",
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "description": "Each variant is an independently sellable configuration",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "condition": {
            "type": "string",
            "enum": [
              "new",
              "used"
            ]
          },
          "color_pl": {
            "type": "string"
          },
          "color_de": {
            "type": "string"
          },
          "color_key": {
            "type": "string",
            "description": "URL-stable key, e.g. blue, grey, green"
          },
          "ral": {
            "type": "string"
          },
          "price_pln_net": {
            "type": "number",
            "description": "Base net price in PLN"
          },
          "price_eur_net": {
            "type": "number",
            "description": "Published net EUR price"
          },
          "eur_mode": {
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ],
            "default": "auto"
          },
          "availability": {
            "type": "string",
            "enum": [
              "in_stock",
              "on_request",
              "out_of_stock"
            ],
            "default": "in_stock"
          },
          "stock": {
            "type": "number"
          },
          "image": {
            "type": "string"
          },
          "merchant_eligible": {
            "type": "boolean",
            "default": false
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "seo_title_pl": {
      "type": "string"
    },
    "seo_title_de": {
      "type": "string"
    },
    "seo_description_pl": {
      "type": "string"
    },
    "seo_description_de": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "slug_pl",
    "slug_de",
    "name_pl",
    "name_de"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}