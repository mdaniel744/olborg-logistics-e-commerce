{
  "name": "FxRateLog",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string"
    },
    "reference_rate": {
      "type": "number"
    },
    "markup_percent": {
      "type": "number"
    },
    "published_rate": {
      "type": "number"
    },
    "manual_override": {
      "type": "boolean"
    },
    "changed_by": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "published_rate"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}