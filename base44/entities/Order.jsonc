{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": [
        "PL",
        "DE"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "pl",
        "de"
      ]
    },
    "currency": {
      "type": "string",
      "enum": [
        "PLN",
        "EUR"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "variant_label": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price_net": {
            "type": "number"
          },
          "image": {
            "type": "string"
          }
        }
      }
    },
    "customer_type": {
      "type": "string",
      "enum": [
        "private",
        "business"
      ]
    },
    "customer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "company": {
          "type": "string"
        },
        "vat_id": {
          "type": "string"
        },
        "nip": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "po_reference": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "vat_validation": {
      "type": "object",
      "properties": {
        "validated": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        },
        "vat_id": {
          "type": "string"
        },
        "company_name": {
          "type": "string"
        },
        "checked_at": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "billing_address": {
      "type": "object",
      "additionalProperties": true
    },
    "delivery_address": {
      "type": "object",
      "additionalProperties": true
    },
    "delivery_country": {
      "type": "string"
    },
    "delivery_postal_code": {
      "type": "string"
    },
    "delivery_instructions": {
      "type": "string"
    },
    "unloading_method": {
      "type": "string"
    },
    "delivery_cost_net": {
      "type": "number"
    },
    "delivery_quote_required": {
      "type": "boolean",
      "default": false
    },
    "tax_snapshot": {
      "type": "object",
      "description": "Immutable tax data at checkout",
      "properties": {
        "vat_rate": {
          "type": "number"
        },
        "vat_amount": {
          "type": "number"
        },
        "net_subtotal": {
          "type": "number"
        },
        "gross_total": {
          "type": "number"
        },
        "treatment": {
          "type": "string",
          "description": "pl_domestic | de_consumer | intra_eu_b2b_0"
        },
        "fx_rate": {
          "type": "number"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "payment_method": {
      "type": "string",
      "default": "bank_transfer"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "awaiting_payment",
        "payment_received",
        "verification_required",
        "paid",
        "cancelled",
        "refunded"
      ],
      "default": "awaiting_payment"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "in_preparation",
        "delivery_scheduled",
        "delivered",
        "cancelled"
      ],
      "default": "new"
    }
  },
  "required": [
    "order_number",
    "market",
    "currency"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}