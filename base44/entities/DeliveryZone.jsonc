{
  "name": "DeliveryZone",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Admin label, e.g. 'PL - Lodzkie'"
    },
    "country": {
      "type": "string",
      "enum": [
        "PL",
        "DE"
      ]
    },
    "postal_prefixes": {
      "type": "array",
      "description": "Postal code prefixes matched against customer input, e.g. ['99','98'] or ['10','12']",
      "items": {
        "type": "string"
      }
    },
    "rates": {
      "type": "array",
      "description": "Net delivery rate per container size, in the market currency (PLN for PL, EUR for DE)",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string",
            "enum": [
              "10ft",
              "20ft",
              "40ft"
            ]
          },
          "rate_net": {
            "type": "number"
          },
          "additional_unit_rate_net": {
            "type": "number",
            "description": "Rate for each additional container of this size"
          }
        }
      }
    },
    "crane_surcharge_net": {
      "type": "number",
      "description": "Optional surcharge for crane (HDS) unloading"
    },
    "manual_quote_only": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "country"
  ]
}