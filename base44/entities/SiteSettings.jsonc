{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "singleton_key": {
      "type": "string",
      "default": "main"
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "default": "Olborg Logistics Sp. z o.o."
        },
        "address_line1": {
          "type": "string",
          "default": "Jana III Sobieskiego 9/23"
        },
        "address_line2": {
          "type": "string",
          "default": "99-200 Podd\u0119bice"
        },
        "country": {
          "type": "string",
          "default": "Poland"
        },
        "phone": {
          "type": "string",
          "default": "+48 505 611 446"
        },
        "email": {
          "type": "string",
          "default": "info@olborglogistics.com"
        },
        "nip": {
          "type": "string"
        },
        "krs": {
          "type": "string"
        },
        "regon": {
          "type": "string"
        },
        "vat_id_pl": {
          "type": "string"
        },
        "vat_id_eu": {
          "type": "string"
        }
      }
    },
    "vat": {
      "type": "object",
      "properties": {
        "pl_standard_rate": {
          "type": "number",
          "default": 23
        },
        "de_consumer_rate": {
          "type": "number",
          "default": 19
        },
        "distance_sales_destination_vat": {
          "type": "boolean",
          "default": true,
          "description": "German consumers pay German destination VAT"
        },
        "b2b_zero_rating_enabled": {
          "type": "boolean",
          "default": true
        },
        "intra_eu_label_pl": {
          "type": "string",
          "default": "Wewn\u0105trzwsp\u00f3lnotowa dostawa towar\u00f3w \u2014 0% VAT (odwrotne obci\u0105\u017cenie)"
        },
        "intra_eu_label_de": {
          "type": "string",
          "default": "Innergemeinschaftliche Lieferung \u2014 0% USt. (Reverse Charge)"
        }
      }
    },
    "fx": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "default": "NBP"
        },
        "reference_rate": {
          "type": "number",
          "description": "Latest fetched EUR/PLN mid rate"
        },
        "reference_fetched_at": {
          "type": "string"
        },
        "published_rate": {
          "type": "number",
          "description": "Rate used for all EUR price calculations until next commit"
        },
        "published_at": {
          "type": "string"
        },
        "markup_percent": {
          "type": "number",
          "default": 0
        },
        "manual_override": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "payment": {
      "type": "object",
      "properties": {
        "sepa_enabled": {
          "type": "boolean",
          "default": true
        },
        "payment_deadline_days": {
          "type": "number",
          "default": 7
        },
        "pln_account": {
          "type": "object",
          "properties": {
            "account_holder": {
              "type": "string"
            },
            "iban": {
              "type": "string"
            },
            "bic": {
              "type": "string"
            },
            "bank_name": {
              "type": "string"
            }
          }
        },
        "eur_account": {
          "type": "object",
          "properties": {
            "account_holder": {
              "type": "string"
            },
            "iban": {
              "type": "string"
            },
            "bic": {
              "type": "string"
            },
            "bank_name": {
              "type": "string"
            }
          }
        },
        "reference_format": {
          "type": "string",
          "default": "Order {order_number}"
        }
      }
    },
    "brand": {
      "type": "object",
      "properties": {
        "primary_color": {
          "type": "string",
          "default": "#1A1C1E"
        },
        "accent_color": {
          "type": "string",
          "default": "#E65100"
        },
        "logo_url": {
          "type": "string"
        }
      }
    },
    "launch_checklist_overrides": {
      "type": "object",
      "additionalProperties": true,
      "description": "Manual check-off state for non-detectable launch items"
    }
  },
  "required": [
    "singleton_key"
  ]
}